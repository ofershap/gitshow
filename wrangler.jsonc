{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "gitshow",
  "main": "cloudflare-worker.mjs",
  "compatibility_date": "2026-06-27",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "workers_dev": true,
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "gitshow"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "NEXT_INC_CACHE_KV",
      "id": "9bea14c0204a453d809bf2b6e38b0f60"
    },
    {
      "binding": "OG_CACHE_KV",
      "id": "8c67f215ddd24b1dbdb6dcedbb27ed30"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "NEXT_CACHE_DO_QUEUE",
        "class_name": "DOQueueHandler"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "DOQueueHandler"
      ]
    }
  ],
  "cache": {
    "enabled": true
  }
}
